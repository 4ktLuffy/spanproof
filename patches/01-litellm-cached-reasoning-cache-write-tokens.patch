+def test_cache_write_token_usage_from_anthropic_shaped_usage(
+    sentry_init, capture_events
+):
+    """LiteLLM maps Anthropic's cache_read/cache_creation counts into prompt_tokens_details."""
+    from litellm.types.utils import Usage
+
+    sentry_init(
+        integrations=[LiteLLMIntegration()],
+        traces_sample_rate=1.0,
+        stream_gen_ai_spans=False,
+    )
+    events = capture_events()
+
+    response = mock.Mock(spec=["usage", "model"])
+    response.model = "claude-sonnet-4-5"
+    response.usage = Usage(
+        prompt_tokens=2600,
+        completion_tokens=120,
+        total_tokens=2720,
+        cache_read_input_tokens=2048,
+        cache_creation_input_tokens=512,
+    )
+    kwargs = {"model": "claude-sonnet-4-5", "messages": [], "litellm_params": {}}
+
+    with start_transaction(name="litellm test"):
+        _input_callback(kwargs)
+        _success_callback(kwargs, response, datetime.now(), datetime.now())
+
+    (event,) = events
+    (span,) = event["spans"]
+    assert span["data"][SPANDATA.GEN_AI_USAGE_INPUT_TOKENS] == 2600
+    assert span["data"][SPANDATA.GEN_AI_USAGE_INPUT_TOKENS_CACHED] == 2048
+    assert span["data"][SPANDATA.GEN_AI_USAGE_INPUT_TOKENS_CACHE_WRITE] == 512
